<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".FineCalculationActivity">

    <!-- Title TextView -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Fine Calculation"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginTop="20dp"
        android:layout_marginStart="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Fine Breakdown TextView -->
    <TextView
        android:id="@+id/tvFineBreakdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Fine Breakdown will appear here"
        android:textSize="16sp"
        android:layout_marginTop="20dp"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- TextView to show total fine -->
    <TextView
        android:id="@+id/tvTotalFine"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Total Fine: ₹0.00"
        android:textSize="18sp"
        android:textColor="#FF0000"
        android:layout_marginTop="30dp"
        app:layout_constraintTop_toBottomOf="@id/tvFineBreakdown"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Button to proceed with fine payment -->
    <Button
        android:id="@+id/btnPayFine"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pay Fine"
        android:textColor="#FFFFFF"
        android:background="@color/colorPrimary"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@id/tvTotalFine"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Button to cancel the fine payment -->
    <Button
        android:id="@+id/btnCancelPayment"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cancel Payment"
        android:textColor="#FFFFFF"
        android:background="@color/colorAccent"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/btnPayFine"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
