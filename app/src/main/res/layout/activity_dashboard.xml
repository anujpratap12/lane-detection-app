<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".DashboardActivity">

    <!-- Title TextView -->
    <TextView
        android:id="@+id/tvDashboardTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Dashboard"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginTop="30dp"
        android:layout_marginStart="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Speed Detection Button -->
    <Button
        android:id="@+id/btnSpeedDetection"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Speed Detection"
        android:textSize="18sp"
        android:backgroundTint="#3F51B5"
        android:textColor="#FFFFFF"
        android:layout_marginTop="50dp"
        app:layout_constraintTop_toBottomOf="@id/tvDashboardTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintHeight_percent="0.1" />

    <!-- Lane Violation Button -->
    <Button
        android:id="@+id/btnLaneViolation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Lane Violation"
        android:textSize="18sp"
        android:backgroundTint="#FF5722"
        android:textColor="#FFFFFF"
        android:layout_marginTop="30dp"
        app:layout_constraintTop_toBottomOf="@id/btnSpeedDetection"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintHeight_percent="0.1" />

    <Button
        android:id="@+id/btnOverspeedingDetection"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Overspeeding Detection"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/someOtherView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Fine Calculation Button -->
    <Button
        android:id="@+id/btnFineCalculation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Fine Calculation"
        android:textSize="18sp"
        android:backgroundTint="#8BC34A"
        android:textColor="#FFFFFF"
        android:layout_marginTop="30dp"
        app:layout_constraintTop_toBottomOf="@id/btnLaneViolation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintHeight_percent="0.1" />

    <!-- School/Hospital Zone Button -->
    <Button
        android:id="@+id/btnSchoolHospitalZone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="School/Hospital Zone"
        android:textSize="18sp"
        android:backgroundTint="#009688"
        android:textColor="#FFFFFF"
        android:layout_marginTop="30dp"
        app:layout_constraintTop_toBottomOf="@id/btnFineCalculation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintHeight_percent="0.1" />

    <!-- Exit/Logout Button -->
    <Button
        android:id="@+id/btnLogout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Logout"
        android:textSize="18sp"
        android:backgroundTint="#F44336"
        android:textColor="#FFFFFF"
        android:layout_marginTop="50dp"
        app:layout_constraintTop_toBottomOf="@id/btnSchoolHospitalZone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
