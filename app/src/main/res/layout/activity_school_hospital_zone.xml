<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SchoolHospitalZoneActivity">

    <!-- Title TextView -->

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="School/Hospital Zone Information"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginTop="20dp"
        android:layout_marginStart="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Zone Description TextView -->
    <TextView
        android:id="@+id/tvZoneDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="This zone has specific rules, such as reduced speed limits and safety measures."
        android:textSize="16sp"
        android:layout_marginTop="20dp"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- VideoView for Zone Video -->
    <VideoView
        android:id="@+id/vvZoneVideo"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:layout_marginTop="30dp"
        app:layout_constraintTop_toBottomOf="@id/tvZoneDescription"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"/>

    <!-- Speed Limit TextView -->
    <TextView
        android:id="@+id/tvSpeedLimit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Speed Limit: 30 km/h"
        android:textSize="18sp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/vvZoneVideo"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Special Rules Information -->
    <TextView
        android:id="@+id/tvSpecialRules"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Special rules apply: Reduced speed limit, school crossing patrols."
        android:textSize="16sp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/tvSpeedLimit"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Button to proceed with detecting violations in this zone -->
    <Button
        android:id="@+id/btnStartDetection"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Start Detection"
        android:textColor="#FFFFFF"
        android:background="@color/colorPrimary"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@id/tvSpecialRules"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Button to return to the previous screen -->
    <Button
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Back"
        android:textColor="#FFFFFF"
        android:background="@color/colorAccent"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/btnStartDetection"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
