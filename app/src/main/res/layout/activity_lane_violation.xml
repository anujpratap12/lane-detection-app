<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".LaneViolationActivity">

    <!-- Title TextView -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Lane Violation Detection"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginTop="20dp"
        android:layout_marginStart="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Video Preview using VideoView -->
    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- VideoView to display the video -->
        <VideoView
            android:id="@+id/videoViewProcessedFrame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignParentTop="true"
            android:layout_centerInParent="true" />

    </RelativeLayout>
    <VideoView
        android:id="@+id/videoPreview"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="#000" />

    <!-- ProgressBar for video processing -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />



    <!-- TextView to display lane violation summary -->
    <TextView
        android:id="@+id/laneViolationSummary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Lane violation summary will appear here"
        android:textSize="16sp"
        android:layout_marginTop="20dp"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toBottomOf="@id/progressBar"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Button to upload lane violation video -->
    <Button
        android:id="@+id/btnUploadLaneVideo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Upload Lane Violation Video"
        android:textColor="#FFFFFF"
        android:background="@color/colorPrimary"
        android:layout_marginTop="30dp"
        app:layout_constraintTop_toBottomOf="@id/laneViolationSummary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Button to show lane violation fine details -->
    <Button
        android:id="@+id/btnShowLaneFine"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Show Lane Violation Fine"
        android:textColor="#FFFFFF"
        android:background="@color/colorAccent"
        android:layout_marginTop="20dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/btnUploadLaneVideo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
      <!-- Initially hidden until video is processed -->



</androidx.constraintlayout.widget.ConstraintLayout>
